{
  "version": 2,
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "vite",
  "functions": {
    "api/create-order.ts": {
      "includeFiles": "firebase-applet-config.json"
    },
    "api/verify-payment.ts": {
      "includeFiles": "firebase-applet-config.json"
    },
    "api/index.ts": {
      "includeFiles": "{api/_server.cjs,firebase-applet-config.json}"
    }
  },
  "rewrites": [
    {
      "source": "/api/((?!create-order$|verify-payment$|payments/config$).*)",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
