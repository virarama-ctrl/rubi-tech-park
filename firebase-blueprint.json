{
  "entities": {
    "CRMLead": {
      "title": "CRMLead",
      "description": "Customer inquiry or lead record captured from website forms or RUBI Assistant chatbot",
      "type": "object",
      "properties": {
        "enquiryId": { "type": "string", "description": "Unique reference enquiry ID (e.g. RTP-2026-9985)" },
        "customerName": { "type": "string", "description": "Full name of the prospective customer" },
        "mobileNumber": { "type": "string", "description": "Contact mobile number" },
        "whatsappNumber": { "type": "string", "description": "WhatsApp number for instant messaging" },
        "email": { "type": "string", "format": "email", "description": "Customer email address" },
        "customerType": { "type": "string", "description": "Customer segment" },
        "serviceCategory": { "type": "string", "description": "Service category (Software Development, Statutory & Compliance, Citizen E-Services)" },
        "selectedService": { "type": "string", "description": "Specific selected service title" },
        "requirement": { "type": "string", "description": "Customer project brief or requirement message" },
        "source": { "type": "string", "description": "Lead acquisition channel" },
        "status": { "type": "string", "description": "Pipeline status" },
        "consentStatus": { "type": "boolean", "description": "Privacy and contact consent" },
        "bookingAmount": { "type": "number", "description": "Booking amount in INR (e.g. 236 for E-Services)" },
        "paymentStatus": { "type": "string", "description": "Payment status" },
        "linkedOrderRef": { "type": "string", "description": "Verified order reference ID linked after payment" },
        "gatewayPaymentId": { "type": "string", "description": "Verified Razorpay payment ID" },
        "receiptNumber": { "type": "string", "description": "Official verified receipt number" },
        "paidAt": { "type": "string", "description": "ISO timestamp when backend verified payment" },
        "createdAt": { "type": "string", "description": "ISO timestamp of lead creation" },
        "updatedAt": { "type": "string", "description": "ISO timestamp of last update" },
        "internalNotes": { "type": "string", "description": "Internal team notes" }
      },
      "required": ["enquiryId", "customerName", "mobileNumber", "email", "selectedService", "status"]
    },
    "AdminRole": {
      "title": "AdminRole",
      "description": "Authorized administrative user profile and role definition",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string" },
        "name": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["email", "role"]
    },
    "ServiceImage": {
      "title": "ServiceImage",
      "description": "Custom reference image override for a specific service in the catalog",
      "type": "object",
      "properties": {
        "serviceId": { "type": "string" },
        "imageUrl": { "type": "string" },
        "updatedAt": { "type": "string" },
        "updatedBy": { "type": "string" }
      },
      "required": ["serviceId", "imageUrl"]
    },
    "PaymentOrder": {
      "title": "PaymentOrder",
      "description": "One-time or subscription payment order & receipt record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderRef": { "type": "string" },
        "customerName": { "type": "string" },
        "customerEmail": { "type": "string" },
        "customerPhone": { "type": "string" },
        "serviceId": { "type": "string" },
        "serviceTitle": { "type": "string" },
        "orderType": { "type": "string" },
        "leadId": { "type": "string" },
        "bookingId": { "type": "string" },
        "subscriptionRef": { "type": "string" },
        "currency": { "type": "string" },
        "amountPaise": { "type": "number" },
        "baseAmountINR": { "type": "number" },
        "taxAmountINR": { "type": "number" },
        "totalAmountINR": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "status": { "type": "string" },
        "refundStatus": { "type": "string" },
        "gatewayOrderId": { "type": "string" },
        "gatewayPaymentId": { "type": "string" },
        "signatureVerified": { "type": "boolean" },
        "verifiedAt": { "type": "string" },
        "upiTransactionRef": { "type": "string" },
        "receiptNumber": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["orderRef", "customerName", "customerEmail", "totalAmountINR", "status"]
    },
    "Subscription": {
      "title": "Subscription",
      "description": "SaaS software subscription and auto-renewal mandate record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "subscriptionRef": { "type": "string" },
        "planId": { "type": "string" },
        "planName": { "type": "string" },
        "billingCycle": { "type": "string" },
        "customerName": { "type": "string" },
        "customerEmail": { "type": "string" },
        "customerPhone": { "type": "string" },
        "totalAmountINR": { "type": "number" },
        "status": { "type": "string" },
        "autoRenew": { "type": "boolean" },
        "autoRenewConsent": { "type": "boolean" },
        "nextBillingAt": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["subscriptionRef", "planId", "customerEmail", "billingCycle", "status"]
    },
    "WebhookEvent": {
      "title": "WebhookEvent",
      "description": "Idempotency ledger for processed Razorpay webhook events",
      "type": "object",
      "properties": {
        "eventId": { "type": "string" },
        "eventType": { "type": "string" },
        "processedAt": { "type": "string" },
        "status": { "type": "string" },
        "summary": { "type": "string" }
      },
      "required": ["eventId", "eventType", "processedAt"]
    }
  },
  "firestore": {
    "/crm_leads/{leadId}": {
      "schema": "CRMLead",
      "description": "Customer enquiry records managed by authorized RUBI TECH PARK administrators"
    },
    "/admin_roles/{email}": {
      "schema": "AdminRole",
      "description": "Authorized administrative accounts permitted to access CRM data"
    },
    "/service_images/{serviceId}": {
      "schema": "ServiceImage",
      "description": "Custom reference image configuration per service"
    },
    "/orders/{orderRef}": {
      "schema": "PaymentOrder",
      "description": "Payment orders, UPI/Razorpay transactions, and refund status records"
    },
    "/subscriptions/{subscriptionRef}": {
      "schema": "Subscription",
      "description": "Software subscription plans, renewal schedules, and mandate states"
    },
    "/webhook_events/{eventId}": {
      "schema": "WebhookEvent",
      "description": "Processed payment gateway webhook idempotency records"
    }
  }
}
