# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN CRM CREDENTIALS (Server-side)
# Used for secure administrator authentication in the RUBI TECH PARK CRM Dashboard.
ADMIN_EMAIL="admin@rubitechpark.com"
ADMIN_INITIAL_PASSWORD="RubiAdmin2026!Secure"
ADMIN_SESSION_SECRET="your-cryptographic-session-secret-key"

# RAZORPAY PAYMENT GATEWAY & SUBSCRIPTIONS (Server-side only — never prefix with VITE_)
# Leave blank in development to use verified business UPI QR & pending verification mode.
# Configure Test keys first, then switch to Live keys after Razorpay KYC approval.
RAZORPAY_MODE="test"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Optional: Pre-created Razorpay Plan IDs for native e-Mandate Subscriptions
RAZORPAY_PLAN_KURALVAANI_MONTHLY=""
RAZORPAY_PLAN_KURALVAANI_YEARLY=""
RAZORPAY_PLAN_BULKMATE_MONTHLY=""
RAZORPAY_PLAN_BULKMATE_YEARLY=""
RAZORPAY_PLAN_CRM_MONTHLY=""
RAZORPAY_PLAN_CRM_YEARLY=""

# NOTE ON FIREBASE & FIRESTORE:
# Firebase Authentication and Cloud Firestore are provisioned and configured automatically
# via `firebase-applet-config.json`. No manual Firebase environment variables are required.
