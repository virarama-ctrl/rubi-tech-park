# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE CLOUD DATABASE CONFIGURATION
# Set these variables to enable direct Supabase PostgreSQL cloud storage.
# If left unset, the system automatically runs in resilient Local Persistent Mode (data/crm_leads.json).
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-public-key"

# ADMIN CRM CREDENTIALS (Server-side only)
ADMIN_EMAIL="admin@rubitechpark.com"
ADMIN_INITIAL_PASSWORD="RubiAdmin2026!Secure"
ADMIN_SESSION_SECRET="your-cryptographic-session-secret-key"

# PAYMENT GATEWAY (UPI & Online Payments)
PAYMENT_GATEWAY_MODE="sandbox"
RAZORPAY_KEY_ID="rzp_test_rtp_sandbox"
RAZORPAY_KEY_SECRET="your-razorpay-secret"
BUSINESS_UPI_ID="rubienterprisesgst-1@okhdfcbank"
