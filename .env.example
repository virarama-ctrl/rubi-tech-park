# =============================================================
# 1. RAZORPAY STANDARD CHECKOUT (Active Payment Flow)
# =============================================================

# Public Key ID used by the Vite frontend (CheckoutPage.tsx) to initialize Razorpay Checkout
# Safe public key only — NEVER expose secrets in VITE_ variables
VITE_RAZORPAY_KEY_ID=""

# Server-side Razorpay Credentials (NEVER prefix with VITE_)
# Leave blank in local development to use Business UPI QR fallback mode.
# Set Test keys (rzp_test_...) first, then switch to Live keys (rzp_live_...) after KYC approval.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_MODE="test"

# Server-side Razorpay Webhook Signature Verification (/api/payments/webhook & /api/webhook)
RAZORPAY_WEBHOOK_SECRET=""

# =============================================================
# 2. SEPARATE APPLICATION FEATURES (Optional / Independent)
# =============================================================

# RUBI Assistant AI Chatbot (/api/chat) — falls back gracefully if omitted
GEMINI_API_KEY=""

# Admin CRM Authentication & Seed Credentials (optional overrides)
ADMIN_EMAIL=""
ADMIN_INITIAL_PASSWORD=""

# Note:
# - Firebase Auth & Cloud Firestore load automatically from `firebase-applet-config.json`.
# - Optional Razorpay Plan IDs for SaaS subscription e-mandates (RAZORPAY_PLAN_KURALVAANI_*,
#   RAZORPAY_PLAN_BULKMATE_*, RAZORPAY_PLAN_CRM_*) are NOT required for Standard Checkout
#   or for initial subscription checkout orders.

