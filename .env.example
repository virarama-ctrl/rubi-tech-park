# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN CRM CREDENTIALS (Server-side)
# Used for secure administrator authentication in the RUBI TECH PARK CRM Dashboard.
ADMIN_EMAIL="admin@rubitechpark.com"
ADMIN_INITIAL_PASSWORD="RubiAdmin2026!Secure"
ADMIN_SESSION_SECRET="your-cryptographic-session-secret-key"

# NOTE ON FIREBASE & FIRESTORE:
# Firebase Authentication and Cloud Firestore are provisioned and configured automatically
# via `firebase-applet-config.json`. No manual Firebase environment variables are required.

# NOTE ON PAYMENTS & UPI:
# Instant UPI QR payments use the verified business UPI ID configured in `src/config/pricingCatalog.ts`.
# No runtime payment gateway secrets are required.
