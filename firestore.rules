rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if caller is an authorized admin
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'admin@rubitechpark.com' ||
        request.auth.token.email == 'admin@elloradigital.in' ||
        request.auth.token.admin == true ||
        request.auth.token.role == 'super_admin' ||
        exists(/databases/$(database)/documents/admin_roles/$(request.auth.uid)) ||
        exists(/databases/$(database)/documents/admin_roles/$(request.auth.token.email))
      );
    }

    // Customer Leads Collection
    match /crm_leads/{leadId} {
      // Allow lead creation with basic validation
      allow create: if request.resource.data.enquiryId != null 
                    && request.resource.data.customerName is string
                    && request.resource.data.mobileNumber is string
                    && request.resource.data.email is string;
      
      // Only authenticated and authorized administrators can read, update, or delete leads
      allow read, update, delete: if isAdmin();
    }

    // Admin Roles Collection (keyed by Firebase UID or administrator email)
    match /admin_roles/{roleId} {
      allow get: if isAdmin() || (
        isAuthenticated() && (
          roleId == request.auth.uid ||
          roleId == request.auth.token.email
        )
      );
      allow list, write: if isAdmin();
    }

    // Service Reference Images Collection
    match /service_images/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Payment Orders Collection (Admin/Server managed only)
    match /orders/{orderRef} {
      allow read, write: if isAdmin();
    }

    // Subscriptions Collection (Admin/Server managed only)
    match /subscriptions/{subscriptionRef} {
      allow read, write: if isAdmin();
    }

    // Webhook Idempotency Events Collection (Admin/Server managed only)
    match /webhook_events/{eventId} {
      allow read, write: if isAdmin();
    }

    // Default fallback deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
