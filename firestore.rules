rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if caller is an authorized admin
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'admin@rubitechpark.com' ||
        request.auth.token.email == 'admin@elloradigital.in' ||
        exists(/databases/$(database)/documents/admin_roles/$(request.auth.token.email))
      );
    }

    // Customer Leads Collection
    match /crm_leads/{leadId} {
      // Allow lead creation with basic validation
      allow create: if request.resource.data.enquiryId != null 
                    && request.resource.data.customerName is string
                    && request.resource.data.mobileNumber is string
                    && request.resource.data.email is string;
      
      // Only authenticated and authorized administrators can read, update, or delete leads
      allow read, update, delete: if isAdmin();
    }

    // Admin Roles Collection
    match /admin_roles/{email} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Default fallback deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
